;;; sbcl --script tests/run.lisp /path/to/actr7.x/load-single-threaded-act-r.lisp
(load (or (second sb-ext:*posix-argv*)
          (error "Pass the ACT-R single-threaded loader pathname.")))
(load (merge-pathnames "../motor-reach.lisp" *load-truename*))

(defvar *reach-tests-passed* 0)
(defvar *reach-test-events* nil)
(defun check-reach (condition description)
  (unless condition (error "FAIL: ~A" description))
  (incf *reach-tests-passed*))
(defun near-reach (one two &optional (epsilon 0.002d0))
  (< (abs (- one two)) epsilon))
(defun rejects-reach (thunk)
  (handler-case (progn (funcall thunk) nil) (error () t)))
(defun record-reach (&rest arguments)
  (check-reach (equalp (reach-position (second arguments)) (third arguments))
               "observer sees committed endpoint")
  (push (cons (mp-time) arguments) *reach-test-events*))
(add-act-r-command "test-record-reach" 'record-reach "Test contact observer.")
(monitor-act-r-command "reach-complete" "test-record-reach")

(check-reach (near-reach (reach-fitts-time 50 5) (+ .05 (* .1 (log 11 2))))
             "Shannon Fitts equation")
(check-reach (= (reach-fitts-time 0 5 :a .05d0) .05d0) "zero distance")
(check-reach (> (reach-fitts-time 100 5) (reach-fitts-time 50 5)) "distance monotonicity")
(check-reach (> (reach-fitts-time 50 2) (reach-fitts-time 50 5)) "width monotonicity")
(check-reach (near-reach (reach-fitts-time 50 5) (reach-fitts-time 500 50)) "unit invariance")
(dolist (arguments '((-1 2) (1 0) (1 -1) (1 2 :a -1) (1 2 :b 0) (#c(1 2) 2)))
  (check-reach (rejects-reach (lambda () (apply #'reach-fitts-time arguments)))
               "invalid Fitts input"))

(clear-all)
(define-model reach-test (sgp :v nil :esc t :randomize-time nil))

;; Python wrappers use these dispatcher commands, not direct Lisp evaluation.
(check-reach (second (multiple-value-list
                       (evaluate-act-r-command "configure-reach-limb" "right-hand"
                                               '(1 2 3) 0 .2d0)))
             "remote configure command")
(check-reach (equalp (second (multiple-value-list
                              (evaluate-act-r-command "reach-position" "right-hand")))
                    '(1 2 3)) "remote position command")
(check-reach (equalp (gethash 'right-hand (reach-state-profiles (current-reach-state)))
                    '(0d0 .2d0)) "remote zero intercept preserved")

;; Use real buffer requests, preparation, execution, and command monitoring.
(defun request-test-reach (limb x y z width)
  (module-request 'manual
    (define-chunk-spec-fct
      (list 'isa 'reach 'limb limb 'target-x x 'target-y y
            'target-z z 'target-width width))))

(dolist (limb *reach-limbs*)
  (reset)
  (setf *reach-test-events* nil)
  (configure-reach-limb limb :a .05d0 :b .1d0)
  (request-test-reach limb 0 30 40 5)
  (run-full-time .1)
  (check-reach (equalp (reach-position limb) '(0 0 0)) "no early position update")
  (check-reach (null *reach-test-events*) "no early contact notification")
  (check-reach (rejects-reach (lambda () (configure-reach-limb limb :a .2)))
               "configuration blocked while busy")
  (run 3)
  (let* ((event (first *reach-test-events*))
         (expected (reach-fitts-time 50 5)))
    (check-reach (= (length *reach-test-events*) 1) "exactly one contact")
    (check-reach (eq (third event) limb) "correct limb in notification")
    (check-reach (near-reach (sixth event) 50) "3D Euclidean distance")
    (check-reach (near-reach (seventh event) expected) "reported movement time")
    (check-reach (near-reach (first event) (+ .3 .05 expected))
                 "six prepared features plus initiation plus Fitts time"))
  (check-reach (equalp (reach-position limb) '(0 30 40)) "position committed at contact")
  (dolist (other (remove limb *reach-limbs*))
    (check-reach (equalp (reach-position other) '(0 0 0)) "other limbs stationary"))
  (request-test-reach limb 0 60 80 5)
  (run 3)
  (check-reach (near-reach (sixth (first *reach-test-events*)) 50)
               "successive distance uses last contact"))

;; Independent limb calibration and signed coordinates.
(reset)
(setf *reach-test-events* nil)
(configure-reach-limb 'left-foot :position '(-3 -4 -12) :a .08d0 :b .2d0)
(request-test-reach 'left-foot 0 0 0 2)
(run 3)
(check-reach (near-reach (sixth (first *reach-test-events*)) 13) "signed 3D coordinates")
(check-reach (near-reach (seventh (first *reach-test-events*))
                         (reach-fitts-time 13 2 :a .08d0 :b .2d0))
             "limb-specific coefficients")
(request-test-reach 'left-foot 0 0 0 2)
(run 3)
(check-reach (near-reach (seventh (first *reach-test-events*)) .08) "zero-distance contact")
(let ((position (reach-position 'left-foot)))
  (setf (first position) 999)
  (check-reach (equalp (reach-position 'left-foot) '(0 0 0)) "position accessor returns a copy"))

;; Preparation of the second reach overlaps the first one's execution.
(reset)
(setf *reach-test-events* nil)
(request-test-reach 'right-hand 0 0 100 5)
(run-full-time .36)
(request-test-reach 'right-hand 0 0 110 5)
(run 5)
(check-reach (= (length *reach-test-events*) 2) "pipelined reaches complete")
(check-reach (near-reach (sixth (first *reach-test-events*)) 10)
             "queued reach measures from previous endpoint")

;; Rejected requests must leave the motor usable, without contacts or movement.
(reset)
(setf *reach-test-events* nil)
(dolist (arguments '((right-hand 1 2 3 0) (right-hand 1 2 3 -1)
                     (tail 1 2 3 2) (left-foot bad 2 3 2)))
  (apply #'request-test-reach arguments)
  (run .1))
(check-reach (eq (mode-s (get-module :motor)) 'free) "invalid requests do not jam motor")
(check-reach (null *reach-test-events*) "invalid requests produce no contacts")
(request-test-reach 'left-hand 1 2 3 2)
(run 2)
(check-reach (= (length *reach-test-events*) 1) "valid request after rejection")

;; Reset clears pending events, positions and configuration, including mid-flight.
(reset)
(configure-reach-limb 'right-foot :position '(1 2 3) :a .7 :b .8)
(request-test-reach 'right-foot 50 0 0 1)
(run-full-time .4)
(reset)
(setf *reach-test-events* nil)
(run-full-time 3)
(check-reach (equalp (reach-position 'right-foot) '(0 0 0)) "reset position")
(check-reach (null *reach-test-events*) "reset cancels pending contact")
(check-reach (equalp (gethash 'right-foot (reach-state-profiles (current-reach-state)))
                    '(.05d0 .10d0)) "reset coefficients")

;; State isolation across models; stock keyboard command still runs.
(configure-reach-limb 'left-hand :position '(7 8 9))
(define-model reach-other (sgp :v nil))
(with-model reach-other
  (check-reach (equalp (reach-position 'left-hand) '(0 0 0)) "per-model state isolation"))
(with-model reach-test
  (check-reach (equalp (reach-position 'left-hand) '(7 8 9)) "first model preserved"))
(with-model reach-other
  (module-request 'manual (define-chunk-spec isa punch hand right finger index))
  (run 2)
  (check-reach (eq (mode-s (get-module :motor)) 'free) "stock motor still operates"))

(load (merge-pathnames "../examples/reaching-controls.lisp" *load-truename*))
(run-reaching-controls)
(check-reach (equalp (reach-position 'right-hand) '(30 40 0)) "example hand endpoint")
(check-reach (equalp (reach-position 'left-foot) '(-10 50 -60)) "example foot endpoint")
(format t "~%PASS: ~D reaching checks.~%" *reach-tests-passed*)
